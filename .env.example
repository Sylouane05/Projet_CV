# Copy to .env.local and fill in your own values. Never commit .env.local.
# Public Firebase web configuration (embedded in the browser bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Private server-only key. Never add a NEXT_PUBLIC prefix to this key.
OPENAI_API_KEY=
# Production AI calls remain disabled unless explicitly enabled.
AI_PUBLIC_ACCESS=disabled

# Public origin used for social previews (Hosting build provides its default URL).
SITE_URL=
